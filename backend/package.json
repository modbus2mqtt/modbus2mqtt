{
  "name": "modbus2mqtt-backend",
  "version": "0.17.4",
  "description": "Backend build/test config for modbus2mqtt",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.production.json",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "lint": "eslint \"src/**/*.{ts,mts,cts,tsx}\" \"tests/**/*.{ts,mts,cts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,mts,cts,tsx}\" \"tests/**/*.{ts,mts,cts,tsx}\"",
    "test:coverage": "vitest run --config vitest.config.mts --coverage --coverage.include=src/specification/**"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "assert": "^2.1.0",
    "async-mutex": "^0.5.0",
    "bootstrap": "^5.3.8",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-server": "^14.1.1",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.15.2",
    "node-html-parser": "^7.1.0",
    "openid-client": "^6.8.7",
    "rxjs": "^7.8.2",
    "url-parse": "^1.5.10",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.35",
    "@angular/cli": "^20.3.35",
    "@babel/preset-typescript": "^7.29.7",
    "@opengovsg/credits-generator": "^1.0.7",
    "@types/adm-zip": "^0.5.8",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.3",
    "@types/url-parse": "^1.4.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^1.6.1",
    "cypress": "^15.21.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-cli": "^30.5.0",
    "jest-junit": "^16.0.0",
    "jest-summarizing-reporter": "^1.1.4",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "typescript-map": "^0.1.0",
    "vitest": "^1.6.1"
  }
}
